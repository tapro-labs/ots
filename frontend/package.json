{
  "name": "@tapro-labs/one-time-secret-frontend",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "check-types": "vue-tsc --noEmit",
    "test": "vitest run",
    "preview": "vite preview",
    "format": "prettier --write --list-different --config .prettierrc.cjs",
    "code-lint-fix": "eslint --fix",
    "style-lint-fix": "stylelint --fix",
    "code-lint-check": "eslint ./src --ext .ts,.vue",
    "style-lint-check": "stylelint ./src/*.{css,scss,vue} ./src/**/*.{css,scss,vue}"
  },
  "dependencies": {
    "@heroicons/vue": "^2.2.0",
    "@kyvg/vue3-notification": "^3.4.2",
    "@tanstack/vue-query": "^5.105.0",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.20.0",
    "copy-to-clipboard": "^4.0.2",
    "daisyui": "3.9.4",
    "epic-spinners": "^2.0.0",
    "js-base64": "^3.9.5",
    "nanoid": "^6.0.2",
    "qrcode.vue": "^3.11.0",
    "vue": "^3.5.44",
    "vue-lottie": "^0.2.1",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@types/lodash.omit": "^4.5.9",
    "@types/node": "^24.19.2",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "autoprefixer": "^10.6.2",
    "eslint": "8.57.1",
    "eslint-import-resolver-typescript": "^3.10.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-no-unsanitized": "4.1.4",
    "eslint-plugin-unicorn": "49.0.0",
    "eslint-plugin-vue": "10.12.0",
    "jsdom": "30.1.3",
    "lodash.omit": "^4.18.0",
    "postcss": "^8.5.32",
    "postcss-html": "^2.0.0",
    "prettier": "3.9.10",
    "sass": "^1.106.1",
    "stylelint": "15.11.0",
    "stylelint-config-standard": "34.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "stylelint-scss": "^5.3.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-search-select": "^3.2.0",
    "vue-tsc": "^3.3.13"
  },
  "volta": {
    "node": "24.22.1",
    "yarn": "1.22.22"
  },
  "engines": {
    "node": ">= 24",
    "yarn": ">= 1.22.22"
  }
}
